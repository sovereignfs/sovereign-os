{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign.local/schemas/trust-rotation-v1.json",
  "title": "Sovereign OS signed trust rotation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "channel", "published_at", "operations", "signing"],
  "properties": {
    "schema_version": { "const": 1 },
    "channel": { "enum": ["preview", "stable"] },
    "published_at": { "type": "string", "format": "date-time" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/add_operation" },
          { "$ref": "#/$defs/revoke_operation" }
        ]
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": { "$ref": "#/$defs/key_id" }
      }
    }
  },
  "$defs": {
    "key_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "add_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "key_id", "algorithm", "channels", "public_key"],
      "properties": {
        "action": { "const": "add" },
        "key_id": { "$ref": "#/$defs/key_id" },
        "algorithm": { "const": "Ed25519" },
        "channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["preview", "stable"] }
        },
        "public_key": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "revoke_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "key_id"],
      "properties": {
        "action": { "const": "revoke" },
        "key_id": { "$ref": "#/$defs/key_id" }
      }
    }
  }
}
