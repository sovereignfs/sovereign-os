#!/usr/bin/python3

import json
import os
import pathlib
import sys
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "lib"))

import sovereign_capabilities as capabilities  # noqa: E402
import sovereign_conversation as conversation  # noqa: E402
import sovereign_inference as inference  # noqa: E402


# Loopback-only, matching every other Sovereign service (console-health,
# console-auth). RFC-0002: reuses console-auth's own session/CSRF
# boundary (ADR-0007) for the mutating /message endpoint rather than
# keeping an independent auth store -- see _check_authentication(). Still
# bound to loopback itself as defense in depth; Nginx is the only thing
# expected to reach it from the LAN.
LISTEN_ADDRESS = os.environ.get("SOVEREIGN_CONVERSATION_ADDRESS", "127.0.0.1")
LISTEN_PORT = int(os.environ.get("SOVEREIGN_CONVERSATION_PORT", "8092"))
MAX_REQUEST_BODY_BYTES = 65536

# console-auth's own loopback port -- see console-auth's
# /api/v1/auth/verify-mutating.
AUTH_BASE_URL = os.environ.get("SOVEREIGN_CONSOLE_AUTH_BASE_URL", "http://127.0.0.1:8091")
AUTH_REQUEST_TIMEOUT_SECONDS = 5

# ADR-0013: llama.cpp + Qwen2.5-3B-Instruct is the selected runner/model;
# the default base URL matches the benchmark harness's own default for
# a locally running llama-server.
PROVIDER_BASE_URL = os.environ.get("SOVEREIGN_INFERENCE_BASE_URL", "http://127.0.0.1:8081")

# Read fresh here, rather than relying on sovereign_capabilities' own
# SOVEREIGN_CAPABILITIES_AUDIT_PATH default: that module is process-wide
# cached, so once anything else has imported it the env var can no longer
# change its AUDIT_LOG_PATH. Passing the path explicitly to process_turn()
# keeps this overridable regardless of import order.
AUDIT_LOG_PATH = pathlib.Path(
    os.environ.get("SOVEREIGN_CONVERSATION_AUDIT_LOG_PATH", str(capabilities.AUDIT_LOG_PATH))
)

# RFC-0017: the one opt-in policy flag this device has today
# (external_enabled, gating web.search/web.fetch). Read fresh per
# request, not cached at process start, so a change takes effect on the
# next message without a service restart -- the same freshness
# expectation sovereign-update check's own on-demand reads establish
# elsewhere in this project.
POLICY_PATH = pathlib.Path(
    os.environ.get("SOVEREIGN_CONVERSATION_POLICY_PATH", str(conversation.DEFAULT_POLICY_PATH))
)


_registry = conversation.build_registry()
_provider = inference.LlamaCppProvider(base_url=PROVIDER_BASE_URL)
_confirmation_store = capabilities.ConfirmationStore()
_pending_turn_store = conversation.PendingTurnStore()


class ConversationHandler(BaseHTTPRequestHandler):
    server_version = "SovereignConversation/1"
    sys_version = ""

    def _send_json(self, status, payload):
        body = json.dumps(payload, separators=(",", ":")).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(body)

    def _read_json_body(self):
        try:
            length = int(self.headers.get("Content-Length", "0") or "0")
        except ValueError:
            return None
        if length <= 0 or length > MAX_REQUEST_BODY_BYTES:
            return None
        raw = self.rfile.read(length)
        try:
            return json.loads(raw)
        except (UnicodeDecodeError, json.JSONDecodeError):
            return None

    def do_GET(self):
        if self.path == "/api/v1/conversation/health":
            # Deliberately unauthenticated, matching /api/v1/health's own
            # boundary -- liveness/model info only, nothing household-
            # specific, the same reasoning that keeps Console's own health
            # endpoint public.
            self._send_json(200, _provider.health())
        elif self.path == "/api/v1/conversation/policy":
            self._handle_get_policy()
        else:
            self.send_error(404)

    def do_POST(self):
        if self.path == "/api/v1/conversation/message":
            self._handle_message()
        elif self.path == "/api/v1/conversation/policy":
            self._handle_set_policy()
        else:
            self.send_error(404)

    def _check_authentication(self):
        """Delegates to console-auth's session+CSRF check (RFC-0002:
        reuse the existing auth boundary rather than keep an independent
        one). Returns True if the caller may proceed; otherwise sends the
        appropriate error response itself and returns False."""
        request = urllib.request.Request(
            f"{AUTH_BASE_URL}/api/v1/auth/verify-mutating", method="GET"
        )
        cookie = self.headers.get("Cookie")
        if cookie:
            request.add_header("Cookie", cookie)
        csrf_header = self.headers.get("X-CSRF-Token")
        if csrf_header:
            request.add_header("X-CSRF-Token", csrf_header)
        try:
            urllib.request.urlopen(request, timeout=AUTH_REQUEST_TIMEOUT_SECONDS)  # noqa: S310
            return True
        except urllib.error.HTTPError as error:
            if error.code == 401:
                self._send_json(401, {"error": {"code": "NOT_AUTHENTICATED", "message": "a valid Console session is required"}})
            elif error.code == 403:
                self._send_json(403, {"error": {"code": "CSRF_MISMATCH", "message": "missing or invalid CSRF token"}})
            else:
                self._send_json(502, {"error": {"code": "AUTH_SERVICE_ERROR", "message": "the authentication service returned an unexpected response"}})
            return False
        except (urllib.error.URLError, OSError):
            self._send_json(503, {"error": {"code": "AUTH_SERVICE_UNAVAILABLE", "message": "could not reach the authentication service"}})
            return False

    def _handle_message(self):
        if not self._check_authentication():
            return
        body = self._read_json_body()
        if not isinstance(body, dict):
            self._send_json(400, {"error": {"code": "INVALID_REQUEST", "message": "a JSON object body is required"}})
            return

        confirmation = body.get("confirmation")
        if confirmation is not None:
            self._handle_confirmation(confirmation)
            return

        if not isinstance(body.get("message"), str) or not body["message"].strip():
            self._send_json(400, {"error": {"code": "INVALID_REQUEST", "message": "a non-empty 'message' string is required"}})
            return
        history = body.get("messages")
        if history is None:
            history = []
        if not isinstance(history, list):
            self._send_json(400, {"error": {"code": "INVALID_REQUEST", "message": "'messages' must be a list if present"}})
            return

        try:
            result = conversation.process_turn(
                _provider, _registry, history, body["message"],
                policy=conversation.read_policy(POLICY_PATH),
                confirmation_store=_confirmation_store,
                pending_turn_store=_pending_turn_store,
                audit_log_path=AUDIT_LOG_PATH,
            )
        except conversation.TurnError as error:
            self._send_json(502, {"error": {"code": error.code, "message": str(error)}})
            return

        self._send_json(200, result)

    def _handle_confirmation(self, confirmation):
        if (
            not isinstance(confirmation, dict)
            or not isinstance(confirmation.get("token"), str)
            or not confirmation["token"]
            or not isinstance(confirmation.get("approve"), bool)
        ):
            self._send_json(400, {
                "error": {
                    "code": "INVALID_REQUEST",
                    "message": "'confirmation' must be an object with a non-empty string 'token' and a boolean 'approve'",
                },
            })
            return

        try:
            result = conversation.resume_turn(
                _provider, _registry, _pending_turn_store, _confirmation_store,
                confirmation["token"], confirmation["approve"],
                policy=conversation.read_policy(POLICY_PATH),
                audit_log_path=AUDIT_LOG_PATH,
            )
        except conversation.TurnError as error:
            # INVALID_CONFIRMATION is the caller's own mistake (unknown,
            # expired-from-this-store's-perspective, or replayed token) --
            # every other TurnError this can raise (PROVIDER_UNAVAILABLE
            # and friends, from continuing the turn after resuming) is the
            # same downstream-failure shape process_turn's own errors
            # already use.
            status = 400 if error.code == "INVALID_CONFIRMATION" else 502
            self._send_json(status, {"error": {"code": error.code, "message": str(error)}})
            return

        self._send_json(200, result)

    def _handle_get_policy(self):
        # Authenticated like every other mutating-adjacent Console
        # surface here, even though this specific request only reads --
        # this is administrative device configuration, not liveness
        # info, and it's only ever rendered inside the already-signed-in
        # Chat experience, so gating it the same way avoids a second,
        # inconsistent trust boundary for one settings row.
        if not self._check_authentication():
            return
        policy = conversation.read_policy(POLICY_PATH)
        self._send_json(200, {"web_search_enabled": policy["external_enabled"]})

    def _handle_set_policy(self):
        if not self._check_authentication():
            return
        body = self._read_json_body()
        if not isinstance(body, dict) or not isinstance(body.get("web_search_enabled"), bool):
            self._send_json(400, {
                "error": {
                    "code": "INVALID_REQUEST",
                    "message": "'web_search_enabled' must be a boolean",
                },
            })
            return
        try:
            policy = conversation.write_policy(body["web_search_enabled"], POLICY_PATH)
        except OSError as error:
            self._send_json(502, {"error": {"code": "POLICY_WRITE_FAILED", "message": f"could not persist the policy change: {error}"}})
            return
        self._send_json(200, {"web_search_enabled": policy["external_enabled"]})

    def log_message(self, format_string, *arguments):
        return


if __name__ == "__main__":
    server = ThreadingHTTPServer((LISTEN_ADDRESS, LISTEN_PORT), ConversationHandler)
    server.serve_forever()
