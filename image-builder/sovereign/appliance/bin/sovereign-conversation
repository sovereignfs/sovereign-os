#!/usr/bin/python3

import json
import os
import pathlib
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "lib"))

import sovereign_capabilities as capabilities  # noqa: E402
import sovereign_conversation as conversation  # noqa: E402
import sovereign_inference as inference  # noqa: E402


# Loopback-only, matching every other Sovereign service (console-health,
# console-auth). RFC-0002 calls for this to sit behind the same
# authentication boundary console-auth already established (ADR-0007) --
# that integration is NOT done here. This service is not yet safe to
# reach from anything but another loopback-only, already-trusted process;
# it must not be proxied to the LAN as-is.
LISTEN_ADDRESS = os.environ.get("SOVEREIGN_CONVERSATION_ADDRESS", "127.0.0.1")
LISTEN_PORT = int(os.environ.get("SOVEREIGN_CONVERSATION_PORT", "8092"))
MAX_REQUEST_BODY_BYTES = 65536

# ADR-0013: llama.cpp + Qwen2.5-3B-Instruct is the selected runner/model;
# the default base URL matches the benchmark harness's own default for
# a locally running llama-server.
PROVIDER_BASE_URL = os.environ.get("SOVEREIGN_INFERENCE_BASE_URL", "http://127.0.0.1:8081")

# Read fresh here, rather than relying on sovereign_capabilities' own
# SOVEREIGN_CAPABILITIES_AUDIT_PATH default: that module is process-wide
# cached, so once anything else has imported it the env var can no longer
# change its AUDIT_LOG_PATH. Passing the path explicitly to process_turn()
# keeps this overridable regardless of import order.
AUDIT_LOG_PATH = pathlib.Path(
    os.environ.get("SOVEREIGN_CONVERSATION_AUDIT_LOG_PATH", str(capabilities.AUDIT_LOG_PATH))
)

_registry = conversation.build_registry()
_provider = inference.LlamaCppProvider(base_url=PROVIDER_BASE_URL)
_confirmation_store = capabilities.ConfirmationStore()


class ConversationHandler(BaseHTTPRequestHandler):
    server_version = "SovereignConversation/1"
    sys_version = ""

    def _send_json(self, status, payload):
        body = json.dumps(payload, separators=(",", ":")).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(body)

    def _read_json_body(self):
        try:
            length = int(self.headers.get("Content-Length", "0") or "0")
        except ValueError:
            return None
        if length <= 0 or length > MAX_REQUEST_BODY_BYTES:
            return None
        raw = self.rfile.read(length)
        try:
            return json.loads(raw)
        except (UnicodeDecodeError, json.JSONDecodeError):
            return None

    def do_GET(self):
        if self.path == "/api/v1/conversation/health":
            self._send_json(200, _provider.health())
        else:
            self.send_error(404)

    def do_POST(self):
        if self.path == "/api/v1/conversation/message":
            self._handle_message()
        else:
            self.send_error(404)

    def _handle_message(self):
        body = self._read_json_body()
        if not isinstance(body, dict) or not isinstance(body.get("message"), str) or not body["message"].strip():
            self._send_json(400, {"error": {"code": "INVALID_REQUEST", "message": "a non-empty 'message' string is required"}})
            return
        history = body.get("messages")
        if history is None:
            history = []
        if not isinstance(history, list):
            self._send_json(400, {"error": {"code": "INVALID_REQUEST", "message": "'messages' must be a list if present"}})
            return

        try:
            result = conversation.process_turn(
                _provider, _registry, history, body["message"],
                confirmation_store=_confirmation_store,
                audit_log_path=AUDIT_LOG_PATH,
            )
        except conversation.TurnError as error:
            self._send_json(502, {"error": {"code": error.code, "message": str(error)}})
            return

        self._send_json(200, result)

    def log_message(self, format_string, *arguments):
        return


if __name__ == "__main__":
    server = ThreadingHTTPServer((LISTEN_ADDRESS, LISTEN_PORT), ConversationHandler)
    server.serve_forever()
