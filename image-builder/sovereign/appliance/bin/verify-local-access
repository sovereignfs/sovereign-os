#!/bin/sh

set -eu

state_dir=/data/sovereign
marker=${state_dir}/local-access-ready

nginx -t

# nginx and sovereign-console.service both just started (or were just
# restarted mid-activation by `sovereign-update install`, which gives them
# far less natural settle time than a cold boot's staggered unit startup)
# -- an immediate, unretried curl here can race a backend that isn't
# listening yet, giving a transient 502/404 rather than a real failure.
# Confirmed on real hardware (ADR-0009 qualification, attempt 8): this
# same started-too-fast pattern already required a retry loop once this
# session, for verify-update-health's Pi-hole checks.
attempt=0
until root_redirect=$(curl --silent --show-error --max-time 10 \
  --output /dev/null --write-out '%{redirect_url}' \
  http://127.0.0.1/) && [ "$root_redirect" = http://127.0.0.1/console/ ] && \
  curl --fail --silent --show-error --max-time 10 \
  --output /dev/null http://127.0.0.1/console/
do
  attempt=$((attempt + 1))
  [ "$attempt" -lt 30 ] || exit 1
  sleep 1
done

attempt=0
until curl --fail --silent --show-error --max-time 10 \
  http://127.0.0.1/api/v1/health | \
  grep -q '"status":"healthy"'
do
  attempt=$((attempt + 1))
  [ "$attempt" -lt 30 ] || exit 1
  sleep 1
done

dns_redirect=$(curl --silent --show-error --max-time 10 \
  --output /dev/null --write-out '%{redirect_url}' \
  http://127.0.0.1/dns/)
test "$dns_redirect" = http://127.0.0.1/dns/admin/

# ADR-0010: /dns/admin/ is now gated behind a Console session -- this
# unauthenticated request is expected to be bounced to Console's sign-in
# with the original path preserved, not served Pi-hole's UI directly.
# Pi-hole's own liveness is already covered by health_api above
# (console-health's pihole check is a direct TCP probe of its own port);
# this step instead confirms the auth_request gate itself is live.
pihole_gate_redirect=$(curl --silent --show-error --max-time 10 \
  --output /dev/null --write-out '%{redirect_url}' \
  http://127.0.0.1/dns/admin/)
test "$pihole_gate_redirect" = "http://127.0.0.1/console/?next=/dns/admin/"

test "$(curl --silent --output /dev/null --write-out '%{http_code}' \
  --max-time 10 http://127.0.0.1/admin/)" = 404
test "$(curl --silent --output /dev/null --write-out '%{http_code}' \
  --max-time 10 http://127.0.0.1/api/)" = 404
test "$(curl --path-as-is --silent --output /dev/null --write-out '%{http_code}' \
  --max-time 10 http://127.0.0.1/dns/../admin/)" = 404

install -d -m 0755 "$state_dir"
{
  printf 'nginx=pass\n'
  printf 'root_redirect=pass\n'
  printf 'console=pass\n'
  printf 'health_api=pass\n'
  printf 'dns_redirect=pass\n'
  printf 'pihole_gate=pass\n'
  printf 'reserved_paths=pass\n'
  printf 'path_escape=pass\n'
} > "${marker}.tmp"
mv "${marker}.tmp" "$marker"
