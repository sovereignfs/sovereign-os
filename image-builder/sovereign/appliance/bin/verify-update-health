#!/bin/sh

set -eu

# Pi-hole's own Docker healthcheck, and the rest of this checklist, do not
# necessarily pass in the instant right after `systemctl start` returns.
# The container's health STATUS only updates on Docker's own healthcheck
# cadence (this image doesn't override the default: interval=30s), not on
# every poll here -- if the first check or two land before FTL is fully
# settled, the status won't flip to "healthy" until a later scheduled
# check succeeds, potentially 30-60s+ later, regardless of how fast this
# script polls. A short retry budget (previously 60s total) can therefore
# still lose the race even though this is no longer a single-shot check;
# confirmed on real hardware where an initial fix using a 60s budget still
# failed even though every individual check passed cleanly moments later.
# 140s comfortably covers several healthcheck cycles while staying under
# the caller's HEALTH_CHECK_TIMEOUT_SECONDS (180s) subprocess timeout.
attempt=0
max_attempts=70

# Named check functions so a final exhaustion can report exactly which
# check(s) are failing, instead of `set -e` bailing out on the first one
# alphabetically and leaving the rest unknown. The caller
# (sovereign-update's run_checked) previously discarded this script's
# stdout/stderr entirely, so on real-hardware failures the only evidence
# was an after-the-fact `docker inspect`, whose health log only retains
# the last 5 entries -- by the time anyone looked, the window that
# mattered had already rotated out. This script now always names the
# failing check(s) on its own, so the caller doesn't have to capture
# anything for the failure to be diagnosable.

check_docker_health() {
  docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' pihole 2>/dev/null |
    grep -qx healthy
}

check_dig_tcp() {
  dig +tcp +short +time=3 +tries=1 @127.0.0.1 pi.hole | grep -q .
}

check_dig_udp() {
  dig +notcp +short +time=3 +tries=1 @127.0.0.1 pi.hole | grep -q .
}

check_pihole_admin() {
  curl --fail --silent --show-error --max-time 10 \
    --output /dev/null http://127.0.0.1:8080/admin/
}

check_nginx_config() {
  nginx -t >/dev/null 2>&1
}

check_dns_admin_proxy() {
  curl --fail --silent --show-error --max-time 10 \
    --output /dev/null http://127.0.0.1/dns/admin/
}

check_admin_404() {
  code="$(curl --silent --output /dev/null --write-out '%{http_code}' \
    --max-time 10 http://127.0.0.1/admin/)"
  test "$code" = 404
}

check_api_404() {
  code="$(curl --silent --output /dev/null --write-out '%{http_code}' \
    --max-time 10 http://127.0.0.1/api/)"
  test "$code" = 404
}

check_data_mount() {
  findmnt -rn -o TARGET /data | grep -qx /data
}

all_checks_pass() {
  check_docker_health &&
  check_dig_tcp &&
  check_dig_udp &&
  check_pihole_admin &&
  check_nginx_config &&
  check_dns_admin_proxy &&
  check_admin_404 &&
  check_api_404 &&
  check_data_mount
}

report_failures() {
  # Run every check independently (not short-circuited by &&) so a single
  # exhausted attempt reports the complete picture, not just whichever
  # check happens to be first in the list.
  set +e
  echo "verify-update-health: giving up after ${max_attempts} attempts; per-check results:" >&2
  check_docker_health
  status=$?
  if [ "$status" -eq 0 ]; then
    echo "  docker-health: OK" >&2
  else
    echo "  docker-health: FAIL (status=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' pihole 2>&1))" >&2
  fi
  check_dig_tcp; [ $? -eq 0 ] && echo "  dig-tcp: OK" >&2 || echo "  dig-tcp: FAIL" >&2
  check_dig_udp; [ $? -eq 0 ] && echo "  dig-udp: OK" >&2 || echo "  dig-udp: FAIL" >&2
  check_pihole_admin; [ $? -eq 0 ] && echo "  pihole-admin: OK" >&2 || echo "  pihole-admin: FAIL" >&2
  check_nginx_config
  status=$?
  if [ "$status" -eq 0 ]; then
    echo "  nginx-config: OK" >&2
  else
    echo "  nginx-config: FAIL ($(nginx -t 2>&1 | tr '\n' ' '))" >&2
  fi
  check_dns_admin_proxy; [ $? -eq 0 ] && echo "  dns-admin-proxy: OK" >&2 || echo "  dns-admin-proxy: FAIL" >&2
  admin_code="$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 10 http://127.0.0.1/admin/ 2>/dev/null || echo unreachable)"
  if [ "$admin_code" = 404 ]; then
    echo "  admin-404: OK" >&2
  else
    echo "  admin-404: FAIL (got $admin_code, want 404)" >&2
  fi
  api_code="$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 10 http://127.0.0.1/api/ 2>/dev/null || echo unreachable)"
  if [ "$api_code" = 404 ]; then
    echo "  api-404: OK" >&2
  else
    echo "  api-404: FAIL (got $api_code, want 404)" >&2
  fi
  check_data_mount; [ $? -eq 0 ] && echo "  data-mount: OK" >&2 || echo "  data-mount: FAIL" >&2
  set -e
}

until all_checks_pass; do
  attempt=$((attempt + 1))
  if [ "$attempt" -ge "$max_attempts" ]; then
    report_failures
    exit 1
  fi
  sleep 2
done
