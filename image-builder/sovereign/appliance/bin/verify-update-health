#!/bin/sh

set -eu

# Pi-hole's own Docker healthcheck, and the rest of this checklist, do not
# necessarily pass in the instant right after `systemctl start` returns.
# The container's health STATUS only updates on Docker's own healthcheck
# cadence (this image doesn't override the default: interval=30s), not on
# every poll here -- if the first check or two land before FTL is fully
# settled, the status won't flip to "healthy" until a later scheduled
# check succeeds, potentially 30-60s+ later, regardless of how fast this
# script polls. A short retry budget (previously 60s total) can therefore
# still lose the race even though this is no longer a single-shot check;
# confirmed on real hardware where an initial fix using a 60s budget still
# failed even though every individual check passed cleanly moments later.
# 140s comfortably covers several healthcheck cycles while staying under
# the caller's HEALTH_CHECK_TIMEOUT_SECONDS (180s) subprocess timeout.
attempt=0
max_attempts=70

all_checks_pass() {
  docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' pihole 2>/dev/null |
    grep -qx healthy &&
  dig +tcp +short +time=3 +tries=1 @127.0.0.1 pi.hole | grep -q . &&
  dig +notcp +short +time=3 +tries=1 @127.0.0.1 pi.hole | grep -q . &&
  curl --fail --silent --show-error --max-time 10 \
    --output /dev/null http://127.0.0.1:8080/admin/ &&
  nginx -t >/dev/null 2>&1 &&
  curl --fail --silent --show-error --max-time 10 \
    --output /dev/null http://127.0.0.1/dns/admin/ &&
  test "$(curl --silent --output /dev/null --write-out '%{http_code}' \
    --max-time 10 http://127.0.0.1/admin/)" = 404 &&
  test "$(curl --silent --output /dev/null --write-out '%{http_code}' \
    --max-time 10 http://127.0.0.1/api/)" = 404 &&
  findmnt -rn -o TARGET /data | grep -qx /data
}

until all_checks_pass; do
  attempt=$((attempt + 1))
  if [ "$attempt" -ge "$max_attempts" ]; then
    # Run once more outside the loop so the real failure (not just a
    # generic timeout) is what the caller sees in its own error output.
    nginx -t
    docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' pihole |
      grep -qx healthy
    dig +tcp +short +time=3 +tries=1 @127.0.0.1 pi.hole | grep -q .
    dig +notcp +short +time=3 +tries=1 @127.0.0.1 pi.hole | grep -q .
    curl --fail --silent --show-error --max-time 10 \
      --output /dev/null http://127.0.0.1:8080/admin/
    curl --fail --silent --show-error --max-time 10 \
      --output /dev/null http://127.0.0.1/dns/admin/
    test "$(curl --silent --output /dev/null --write-out '%{http_code}' \
      --max-time 10 http://127.0.0.1/admin/)" = 404
    test "$(curl --silent --output /dev/null --write-out '%{http_code}' \
      --max-time 10 http://127.0.0.1/api/)" = 404
    findmnt -rn -o TARGET /data | grep -qx /data
    exit 1
  fi
  sleep 2
done
