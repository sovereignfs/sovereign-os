#!/usr/bin/python3

import base64
import getpass
import grp
import hashlib
import os
import pathlib
import secrets
import sys


CREDENTIAL_PATH = pathlib.Path(
    os.environ.get(
        "SOVEREIGN_CONSOLE_CREDENTIAL_PATH",
        "/data/sovereign/console/admin-password.hash",
    )
)
GROUP_NAME = os.environ.get("SOVEREIGN_CONSOLE_GROUP", "sovereign-console")
PBKDF2_ITERATIONS = 600_000
MINIMUM_LENGTH = 12


def hash_password(password):
    salt = secrets.token_bytes(16)
    derived = hashlib.pbkdf2_hmac("sha256", password.encode(), salt, PBKDF2_ITERATIONS)
    return "pbkdf2_sha256${}${}${}".format(
        PBKDF2_ITERATIONS,
        base64.b64encode(salt).decode(),
        base64.b64encode(derived).decode(),
    )


def main():
    if os.geteuid() != 0:
        print("Run this command with sudo.", file=sys.stderr)
        return 1
    if not sys.stdin.isatty():
        print("An interactive terminal is required.", file=sys.stderr)
        return 1

    try:
        group = grp.getgrnam(GROUP_NAME)
    except KeyError:
        print(f"The {GROUP_NAME} group is missing.", file=sys.stderr)
        return 1

    password = getpass.getpass("New Console password (minimum 12 characters): ")
    confirmation = getpass.getpass("Confirm new Console password: ")

    if password != confirmation:
        print("Passwords do not match.", file=sys.stderr)
        return 1
    if len(password) < MINIMUM_LENGTH:
        print(f"Password must contain at least {MINIMUM_LENGTH} characters.", file=sys.stderr)
        return 1

    CREDENTIAL_PATH.parent.mkdir(parents=True, exist_ok=True)
    os.chmod(CREDENTIAL_PATH.parent, 0o750)
    os.chown(CREDENTIAL_PATH.parent, 0, group.gr_gid)

    encoded = hash_password(password)
    temporary_path = CREDENTIAL_PATH.with_suffix(".tmp")
    old_umask = os.umask(0o077)
    try:
        temporary_path.write_text(encoded + "\n")
    finally:
        os.umask(old_umask)
    os.chmod(temporary_path, 0o640)
    os.chown(temporary_path, 0, group.gr_gid)
    temporary_path.replace(CREDENTIAL_PATH)

    password = confirmation = encoded = ""
    print("Console password updated.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
