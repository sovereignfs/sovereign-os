# --- Base-OS (RFC-0016 tryboot A/B) update support ---
#
# A base-OS release is independently versioned and independently
# triggered from an appliance release (RFC-0016's own explicit design
# decision), and its artifacts are a raw boot-partition image and a raw
# root-partition image, not a tar bundle extracted into an existing
# writable filesystem -- appliance updates' prepare/backup/stage/activate
# pipeline doesn't apply, so this is a parallel set of functions and a
# parallel manifest schema, reusing shared primitives (signature
# verification, the atomic-write/journal-event pattern, the health-check
# command) rather than the appliance-specific transaction machinery.
BASE_OS_RELEASE_PATH = pathlib.Path(
    os.environ.get("SOVEREIGN_BASE_OS_RELEASE_PATH", "/etc/sovereign-base-os-release")
)
# Artifacts are zstd-compressed for realistic distribution size (a 3G raw
# root image compresses to well under a third of that) -- the media type
# says so explicitly, matching the existing update_bundle convention
# (+tar+zstd). write_raw_artifact decompresses while writing; nothing
# about the manifest's size/sha256 fields changes, since those still
# describe exactly the compressed bytes that get downloaded and verified.
BASE_OS_BOOT_MEDIA_TYPE = "application/vnd.sovereign.base-os.boot.v1+raw+zstd"
BASE_OS_ROOT_MEDIA_TYPE = "application/vnd.sovereign.base-os.root.v1+raw+zstd"
# The rpi-ab-slot-mapper-provided by-slot symlinks are the same,
# already-hardware-verified mechanism the running system boots through
# (RFC-0016's Testing Strategy) -- writes always target "other", read
# fresh at write time, never a slot identity computed independently by
# this script, so there is exactly one source of truth for which device
# node is safe to overwrite. Overridable for testing.
SLOT_OTHER_BOOT_DEVICE = pathlib.Path(
    os.environ.get("SOVEREIGN_SLOT_OTHER_BOOT_DEVICE", "/dev/disk/by-slot/other/boot")
)
SLOT_OTHER_SYSTEM_DEVICE = pathlib.Path(
    os.environ.get("SOVEREIGN_SLOT_OTHER_SYSTEM_DEVICE", "/dev/disk/by-slot/other/system")
)
SLOT_ACTIVE_BOOT_DEVICE = pathlib.Path(
    os.environ.get("SOVEREIGN_SLOT_ACTIVE_BOOT_DEVICE", "/dev/disk/by-slot/active/boot")
)
SLOT_ACTIVE_SYSTEM_DEVICE = pathlib.Path(
    os.environ.get("SOVEREIGN_SLOT_ACTIVE_SYSTEM_DEVICE", "/dev/disk/by-slot/active/system")
)
AUTOBOOT_PATH = pathlib.Path(os.environ.get("SOVEREIGN_AUTOBOOT_PATH", "/bootfs/autoboot.txt"))
RPI_SLOT_TRYBOOT = os.environ.get("SOVEREIGN_RPI_SLOT_TRYBOOT", "/usr/bin/rpi-slot-tryboot")
REBOOT = os.environ.get("SOVEREIGN_REBOOT", "/usr/sbin/reboot")
BLKID = os.environ.get("SOVEREIGN_BLKID", "/usr/sbin/blkid")

