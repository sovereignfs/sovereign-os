[Unit]
Description=Run a Console-triggered update install
RequiresMountsFor=/data
After=sovereign-data-expand.service sovereign-proof.service network-online.target
Wants=network-online.target
ConditionPathIsMountPoint=/data

[Service]
Type=oneshot
# The trigger file's existence is the only signal this unit trusts (see
# ADR-0008/ADR-0009) -- its content is never read. Removing it first means
# a slow or malfunctioning install cannot cause the .path unit to refire
# on the same request repeatedly.
ExecStartPre=/usr/bin/rm -f /data/sovereign/console/actions/install.request
ExecStart=/usr/sbin/sovereign-update install
# Downloading a real update bundle and running prepare/backup/stage/
# activate can genuinely take several minutes on a modest connection --
# systemd's default 90s TimeoutStartSec would kill this mid-transaction,
# a materially worse failure mode than a slow install. No timeout here;
# sovereign-update's own steps each carry their own health gating and
# don't hang indefinitely on their own.
TimeoutStartSec=0
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/data/sovereign
# nginx's `-t` config test is not a pure parse: it performs real startup
# side effects against the configured directives (it actually attempts to
# bind every listen socket, and chowns worker-owned temp directories to
# the configured `user` UID) rather than just validating syntax. Since
# verify-update-health (invoked by `sovereign-update install`'s health
# gates) shells out to `nginx -t`, this unit needs every capability those
# side effects require, even though the unit itself never binds a port or
# changes file ownership directly. Both of the below were found one at a
# time on real hardware, each manifesting as a distinct PREUPDATE_HEALTH_
# FAILED at the nginx-config check with a different underlying errno:
#  - CAP_NET_BIND_SERVICE: bind() to 0.0.0.0:80 got EACCES
#  - CAP_CHOWN: chown() of /var/lib/nginx/body to the worker UID got EPERM
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER CAP_NET_BIND_SERVICE CAP_CHOWN
UMask=0077
