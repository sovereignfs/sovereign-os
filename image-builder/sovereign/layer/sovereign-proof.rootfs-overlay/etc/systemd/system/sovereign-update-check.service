[Unit]
Description=Check whether a compatible signed Sovereign update is available
RequiresMountsFor=/data
After=sovereign-data-expand.service sovereign-proof.service network-online.target
Wants=network-online.target
ConditionPathIsMountPoint=/data

[Service]
Type=oneshot
ExecStart=/usr/sbin/sovereign-update check
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/data/sovereign
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER
UMask=0077
