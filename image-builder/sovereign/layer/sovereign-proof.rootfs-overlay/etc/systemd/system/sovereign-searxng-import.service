[Unit]
Description=Import the embedded SearXNG ARM64 image
Requires=docker.service sovereign-searxng-artifact.service
After=docker.service sovereign-searxng-artifact.service
RequiresMountsFor=/data
ConditionPathIsMountPoint=/data

[Service]
Type=oneshot
ExecStart=/usr/lib/sovereign/import-searxng-image
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
