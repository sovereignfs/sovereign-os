[Unit]
Description=Apply Raspberry Pi Imager provisioning
Documentation=https://github.com/sovereignfs/sovereign-os
After=local-fs.target
Before=network-pre.target iwd.service ssh.service sovereign-pihole.service
Wants=network-pre.target
RequiresMountsFor=/boot/firmware /data
ConditionPathExists=/boot/firmware/rpi-preseed.toml
ConditionPathExists=!/data/sovereign/imager-provisioned

[Service]
Type=oneshot
# apply-imager-provisioning writes directly to /etc/passwd, /etc/shadow,
# /etc/group, /etc/sudoers.d/, and a few other /etc paths. Root is
# read-only at runtime on RFC-0016's A/B images, but /etc itself is a
# persistent, writable overlay there (sovereign-etc-overlay.service, an
# earlier-boot dependency of this one via ordering on local-fs.target) --
# not on today's single-root images, where /etc is just part of the
# already-writable root. Either way, no special handling is needed here.
ExecStart=/usr/lib/sovereign/apply-imager-provisioning
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
