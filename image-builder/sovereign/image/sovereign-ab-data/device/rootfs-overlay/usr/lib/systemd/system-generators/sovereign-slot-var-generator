#!/bin/sh
# systemd generator: bind-mount the current root slot's /var from /data.
#
# Root is read-only at runtime (RFC-0016), so /var must come from
# somewhere writable. Kept per-slot -- not shared between system_a and
# system_b -- so one slot's software never has to interpret state the
# other slot's software wrote. Adapted from rpi-image-gen's own
# ab_userdata reference example (slot-perst-generator), simplified since
# /data already mounts via a plain /etc/fstab entry here and doesn't need
# its own generator-emitted mount unit the way that example's separate
# "persistent" partition did.

set -eu

OUT_DIR="/run/systemd/generator"
mkdir -p "$OUT_DIR"

SLOT=""
ROOT_DEV="$(findmnt -no SOURCE / || true)"
if [ -n "$ROOT_DEV" ]; then
  PARTLABEL="$(blkid -s PARTLABEL -o value -- "$ROOT_DEV" 2>/dev/null || true)"
  case "$(printf '%s' "$PARTLABEL" | tr '[:upper:]' '[:lower:]')" in
    system_a) SLOT="system_a" ;;
    system_b) SLOT="system_b" ;;
  esac
fi
: "${SLOT:=system_a}"

VAR_SRC="/data/sovereign/slots/${SLOT}/var"

cat >"$OUT_DIR/var.mount" <<EOF
[Unit]
Description=Per-slot /var for ${SLOT}
Requires=data.mount
After=data.mount
Before=local-fs.target
ConditionPathExists=${VAR_SRC}

[Mount]
What=${VAR_SRC}
Where=/var
Type=none
Options=bind

[Install]
WantedBy=local-fs.target
EOF
