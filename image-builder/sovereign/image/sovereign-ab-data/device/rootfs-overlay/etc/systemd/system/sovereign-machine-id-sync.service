[Unit]
Description=Sync machine-id to/from persistent storage
DefaultDependencies=no
Requires=data.mount
After=data.mount
Before=systemd-journald.service sysinit.target
ConditionPathExists=/data/sovereign

[Service]
Type=oneshot
ExecStart=/bin/sh -eu -c 'P=/data/sovereign/machine-id; R=/run/machine-id; if [ -s "$P" ]; then cat "$P" > "$R"; else install -m0644 "$R" "$P"; fi'

[Install]
WantedBy=sysinit.target
