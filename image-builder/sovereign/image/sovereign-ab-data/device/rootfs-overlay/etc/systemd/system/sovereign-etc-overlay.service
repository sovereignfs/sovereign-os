[Unit]
Description=Overlay /etc with a persistent, writable upper layer
DefaultDependencies=no
Requires=data.mount
After=data.mount
Before=local-fs.target sysinit.target
ConditionPathExists=/data/sovereign

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/sovereign/mount-etc-overlay

[Install]
WantedBy=local-fs.target
