image <IMAGE_NAME>.<IMAGE_SUFFIX>.sparse {
  android-sparse {
    image = <IMAGE_NAME>.<IMAGE_SUFFIX>
  }
}

image bootconfig.sparse {
  android-sparse {
    image = bootconfig.vfat
  }
}

image boot.sparse {
  android-sparse {
    image = boot.vfat
  }
}

image root.sparse {
  android-sparse {
    image = root.ext4
  }
}

image data.sparse {
  android-sparse {
    image = data.ext4
  }
}

image <IMAGE_NAME>.<IMAGE_SUFFIX> {
  hdimage {
    align = 8M
    partition-table-type = "gpt"
    fill = true
  }

  # Partition numbers matter: autoboot.txt (written below) refers to
  # boot_a/boot_b by number directly, matching rpi-image-gen's own
  # ab_userdata reference example's convention.
  partition bootconfig {
    in-partition-table = true
    image = bootconfig.vfat
    partition-type-uuid = F
    bootable = true
  }

  partition boot_a {
    in-partition-table = true
    image = boot.vfat
    partition-type-uuid = F
    bootable = true
  }

  partition boot_b {
    in-partition-table = true
    image = boot.vfat
    partition-type-uuid = F
    bootable = true
  }

  partition system_a {
    in-partition-table = true
    image = root.ext4
    partition-type-uuid = L
  }

  partition system_b {
    in-partition-table = true
    image = root.ext4
    partition-type-uuid = L
  }

  partition data {
    in-partition-table = true
    image = data.ext4
    partition-type-uuid = L
  }
}

image bootconfig.vfat {
  vfat {
    label = "BOOTCFG"
    file "autoboot.txt" { image = "autoboot.txt" }
    extraargs = "-s 1 -S <SECTOR_SIZE>"
  }
  size = <BOOTCONFIG_SIZE>
}

image boot.vfat {
  vfat {
    label = "<BOOT_LABEL>"
    extraargs = "<VFAT_ARGS>"
  }
  size = <BOOT_SIZE>
  mountpoint = "/boot/firmware"
  exec-pre = "<SETUP> BOOT <ROOT_UUID>"
}

image root.ext4 {
  ext4 {
    label = "ROOT"
    use-mke2fs = true
    mke2fs-conf = <MKE2FS_CONF>
    extraargs = "<MKE2FS_ROOT>"
  }
  size = <ROOT_SIZE>
  mountpoint = "/"
  exec-pre = "<SETUP> ROOT <ROOT_UUID> <BOOT_UUID>"
}

image data.ext4 {
  ext4 {
    label = "DATA"
    use-mke2fs = true
    mke2fs-conf = <MKE2FS_CONF>
    extraargs = "<MKE2FS_DATA>"
  }
  size = <DATA_SIZE>
  mountpoint = "/data"
}
